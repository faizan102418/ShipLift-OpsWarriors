{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRAuthentication",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ShopLiteImagePublishing",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeImages",
        "ecr:DescribeImageScanFindings"
      ],
      "Resource": [
        "arn:aws:ecr:ap-southeast-2:782086108297:repository/shoplite/frontend",
        "arn:aws:ecr:ap-southeast-2:782086108297:repository/shoplite/catalog",
        "arn:aws:ecr:ap-southeast-2:782086108297:repository/shoplite/inventory",
        "arn:aws:ecr:ap-southeast-2:782086108297:repository/shoplite/orders"
      ]
    }
  ]
}
